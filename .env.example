# Copy to .env and fill in. .env is git-ignored.

# --- LLM provider (required) ---
OPENAI_API_KEY=sk-...

# Model used by the extraction / verification / correction agents.
# Default: gpt-5-nano  (see docs/adr/0001-extraction-model.md)
LLM_MODEL=gpt-5-nano

# --- Optional: alternative provider (disabled in config by default) ---
# GROQ_API_KEY=gsk_...
# GROQ_API_KEY_2=gsk_...

# --- Optional: LLM observability (leave blank to disable) ---
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Dataset generation (optional overrides) ---
DATASET_SEED=42
DATASET_TOTAL=60
