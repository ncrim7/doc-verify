# --- secrets ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# --- data & run artifacts (regenerable) ---
# raw* rather than raw/ on purpose: a corpus is sometimes set aside under a
# dated name before regeneration (data/raw_pre_vkn_20260906_010525), and that
# copy is no more committable than the live one. The narrow pattern let 60
# files through once.
data/raw*/
data/processed/
data/metadata/
results/
*.log
*.sqlite
*.sqlite-*

# --- test / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- generated documents (keep only curated test fixtures) ---
*.pdf
!tests/fixtures/**/*.pdf

# --- REAL DOCUMENTS — never commit -------------------------------------
# Real invoices/receipts carry tax ids, addresses, amounts and counterparty
# names. They stay on disk and out of git; only aggregate measurement results
# are ever committed. Belt and braces: whole directories, plus every image
# extension, so a stray screenshot cannot slip in.
inv/
data/real/
data/real_world/
*.jpg
*.jpeg
*.png
*.webp
*.heic
*.tif
*.tiff
!results/charts/**
!docs/**/*.png

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp
